{
  "schema_version": 3,
  "name": "opencode",
  "extends": ["base"],
  "detect": { "binary_names": ["opencode"] },
  "grants": [
    { "path": "~/.config/opencode", "access": "read_write", "scope": "subtree" },
    { "path": "~/.local/share/opencode", "access": "read_write", "scope": "subtree" }
  ],
  "protected_write_paths": [
    "~/.config/opencode/opencode.json",
    "~/.config/opencode/opencode.jsonc"
  ],
  "hook_sources": [
    { "protocol": "open_code_plugin", "location": "open_code_user_plugins", "scope": "directory" }
  ]
}
