{
  "schema_version": 2,
  "name": "claude",
  "extends": ["base"],
  "detect": { "binary_names": ["claude"] },
  "grants": [
    { "path": "~/.claude", "access": "read_write", "scope": "subtree" },
    { "path": "~/.claude.json", "access": "read_write", "scope": "exact" }
  ],
  "protected_write_paths": [
    "~/.claude/settings.json",
    "~/.claude.json"
  ],
  "hook_sources": [
    { "protocol": "claude_settings", "path": "~/.claude/settings.json" },
    { "protocol": "claude_settings", "path": "/Library/Application Support/ClaudeCode/managed-settings.d/20-kontext.json" },
    { "protocol": "claude_settings", "path": "/Library/Application Support/ClaudeCode/managed-settings.json" }
  ]
}
