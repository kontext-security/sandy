{
  "schema_version": 4,
  "name": "claude",
  "extends": ["base"],
  "detect": { "binary_names": ["claude"] },
  "grants": [
    { "path": "~/.claude", "access": "read_write", "scope": "subtree" },
    { "path": "~/.claude.json", "access": "read", "scope": "exact" }
  ],
  "protected_write_paths": [
    "~/.claude/settings.json",
    "~/.claude.json"
  ],
  "hook_sources": [
    { "protocol": "claude_settings", "location": "claude_user_settings" },
    { "protocol": "claude_settings", "location": "fixed", "path": "/Library/Application Support/ClaudeCode/managed-settings.d", "scope": "directory" },
    { "protocol": "claude_settings", "location": "fixed", "path": "/Library/Application Support/ClaudeCode/managed-settings.json" }
  ]
}
