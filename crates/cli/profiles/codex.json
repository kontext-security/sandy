{
  "schema_version": 2,
  "name": "codex",
  "extends": ["base"],
  "detect": { "binary_names": ["codex"] },
  "grants": [
    { "path": "~/.codex", "access": "read_write", "scope": "subtree" }
  ],
  "protected_write_paths": [
    "~/.codex/hooks.json",
    "~/.codex/config.toml"
  ],
  "hook_sources": [
    { "protocol": "codex_hooks", "path": "~/.codex/hooks.json" }
  ]
}
