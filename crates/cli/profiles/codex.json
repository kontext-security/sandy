{
  "schema_version": 4,
  "name": "codex",
  "extends": ["base"],
  "detect": { "binary_names": ["codex"] },
  "grants": [
    { "path": "~/.codex", "access": "read_write", "scope": "subtree" }
  ],
  "protected_write_paths": [
    "~/.codex/hooks.json",
    "~/.codex/config.toml"
  ],
  "hook_sources": [
    { "protocol": "codex_hooks", "location": "codex_user_hooks" },
    { "protocol": "codex_requirements", "location": "fixed", "path": "/etc/codex/requirements.toml" }
  ]
}
