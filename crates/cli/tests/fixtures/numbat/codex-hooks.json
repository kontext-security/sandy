{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "'__NUMBAT_BIN__' hook codex-pre-tool --agent codex --installed-by=numbat --output=file --output-file '__OUTPUT_FILE__'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
